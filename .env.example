# API
PORT=8787
APP_ORIGIN=http://localhost:8081
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_SECRET=replace-with-a-separate-admin-secret

# DeepSeek (leave empty to use deterministic mock mode)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Neon PostgreSQL (leave empty to use the in-memory development store)
DATABASE_URL=
DIRECT_DATABASE_URL=

# Client-exposed API URL. Never put a model/database secret in EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL=http://localhost:8787
